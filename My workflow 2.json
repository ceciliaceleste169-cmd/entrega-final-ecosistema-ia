        "options": {
          "systemMessage": "\"Eres un agente experto de soporte técnico B2B. Analiza el ticket recibido y devuelve ÚNICAMENTE un objeto JSON estricto (sin formato Markdown, sin ```json ni texto adicional) con las siguientes claves: 'categoria' (opciones exactas: 'Bug Crítico', 'Consulta Facturación', 'Dudas Uso', 'Spam'), 'urgencia' (un número entero del 1 al 5), 'resumen' (un texto breve de máximo 2 oraciones) y 'borrador_respuesta' (una respuesta profesional en español redactada para el cliente).\""
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -672,
        -64
      ],
      "id": "2514fb76-ce99-42fd-95fd-023b79da8ac6",
      "name": "Agente de Soporte",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Obtenemos la respuesta generada por Gemini\nlet rawResponse = $input.item.json.output || $input.item.json.text || \"\";\n\n// Limpiamos posibles bloques de código Markdown que la IA a veces agrega\nrawResponse = rawResponse.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n\nlet data = {};\ntry {\n  data = JSON.parse(rawResponse);\n} catch (e) {\n  // Si ocurre un error de formato, asignamos valores por defecto\n  data = {\n    categoria: \"Dudas Uso\",\n    urgencia: 3,\n    resumen: \"Sin resumen disponible.\",\n    borrador_respuesta: \"Gracias por contactarnos. Un agente revisará tu solicitud a la brevedad.\"\n  };\n}\n\nreturn {\n  json: {\n    categoria: data.categoria,\n    urgencia: Number(data.urgencia),\n    resumen: data.resumen,\n    borrador_respuesta: data.borrador_respuesta\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
